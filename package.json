{
  "name": "circuitshield",
  "version": "1.0.0",
  "description": "Circuit breaker gateway with bulkhead isolation and a sliding-window failure detector",
  "private": true,
  "type": "module",
  "homepage": "https://taan1el.github.io/circuitshield/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/circuitshield.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/circuitshield/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:pages": "npm run build:pages --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client"
  },
  "keywords": [
    "circuit-breaker",
    "bulkhead-isolation",
    "resilience",
    "fault-tolerance",
    "sliding-window",
    "hystrix",
    "resilience4j",
    "react19"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT"
}
